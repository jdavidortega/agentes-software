#!/bin/sh
# Hook de la plantilla. El mensaje ENLAZA lo que resuelve (docs/trazabilidad.md §IDs y
# docs/convenciones.md §Git) con trailers de UNA gramática cerrada:
#   Ref: F1|F2|F4|F5       cierre de fase        Ref: I<n>              incremento (existe en plan.md)
#   Ref: hito:I<a>-I<b>    hito: el commit que registra la revisión del conjunto ensamblado
#   Cierra: R-E.<n> | R-I<i>.<n> | R-S<i>.<n> | R-F4.<n> | R-SF4.<n>   (fila en trazabilidad o
#                                                                        Histórico; Estado resuelto|verificado)
# Se validan TODOS los trailers presentes; los IDs se resuelven contra el ÍNDICE (lo que
# va al commit). Cada transición exige su RECIBO en docs/revisiones.log (registro
# estructurado, append-only, leído con scripts/recibos.sh; AGENTS.md §9): la ÚLTIMA línea
# válida del mismo rol+tipo+alcance debe ser PASA con `huella` igual a la del índice
# (scripts/huella.sh indice), de modo que la revisión corresponde al contenido que se guarda:
#   Ref: I<n> → juez-codigo incremento I<n> (+ juez-seguridad si el recibo dice seguridad=requerida);
#               ningún R-I<n>.* ni R-S<n>.* en Estado abierto; `- [x] I<n>` en plan.md y
#               docs/estado.md dentro del commit (el avance a la vista); y como máximo TRES incrementos
#               cerrados (commits `Ref: I<k>` distintos) desde el último commit `Ref: hito:…`,
#               contando este: al cuarto, el hito es obligatorio primero.
#   Ref: hito:I<a>-I<b> → juez-conjunto hito hito:I<a>-I<b> (+ seguridad si requerida, misma
#               huella); el rango existe en plan.md y cada I<a>..I<b> ya tiene su commit `Ref: I`
#               en el historial (el hito revisa lo construido, no lo prometido).
#   Ref: F2   → revisor-funcional encuadre F2 (o reentrada:C<n>, con C<n> definido en encuadre.md),
#               y ningún vacío R-E.* abierto
#   Ref: F4   → juez-conjunto conjunto F4 (no sirve un recibo de hito) (+ seguridad si requerida)
#   Ref: F5   → exactamente lo de F4 (conjunto + seguridad), vigente sobre lo que se commitea
# Ref: F4|F5 dispara además check_docs en modo cierre.
# CONTRATO REVISADO (la verdad acordada): las líneas `- C<n>:`, la ÚNICA sección `## Set de oro` de
# docs/encuadre.md y el contenido exacto de los archivos que esa sección referencia, leídos con el lector
# único scripts/contrato.py desde los OBJETOS (índice, o el commit en replay; nunca el árbol de trabajo)
# tal como estaban en el ÚLTIMO commit `Ref: F2` del historial (en un proyecto adoptado, posterior a la
# «Base del método» de docs/convenciones.md: un trailer previo no acredita revisión). Esa lectura rige si el
# scripts/check_docs.sh del candidato declara «# contrato-set-de-oro: 1»; sin el marcador (un commit
# anterior), la comparación previa de `- C<n>:` y la sección. Con el marcador, si ese último `Ref: F2` no
# vale como referencia (el lector da ERR), el trabajo dependiente exige migrarlo con un `Ref: F2` de alcance
# F2 completo (reentrada:C<n> no basta).
# Todo trabajo DEPENDIENTE (Ref: I<n>, Ref: hito, Ref: F4, Ref: F5) exige que el candidato
# tenga ese contrato idéntico; sin ningún `Ref: F2` no hay contrato y se rechaza. `Ref: F1` edita el
# encuadre libremente (borrador, reencuadre F3→F1, Fase 1 de una adopción) y `Ref: F2` fija el contrato
# nuevo (su recibo lleva la huella del índice, que incluye encuadre.md); con alcance reentrada:C<n>
# solo puede haber cambiado ese criterio (varios ⇒ alcance F2). La fase declarada no interviene, con
# una excepción: ENTRAR a F5 (estado.md pasa a F5) exige `Ref: F5`, que dispara el cierre.
# Un MERGE LIMPIO queda exento del trailer y del `Ref: I<n>` por el código que integra (ya revisado en sus
# commits), pero NO de estas invariantes sobre el resultado: entrar a F5 y conservar los hallazgos.
# TRANSICIONES de docs/trazabilidad.md: ningún hallazgo (R-E, R-I, R-S, R-F4, R-SF4) con fila o entrada
# del Histórico en HEAD desaparece; una fila que PASA a resuelto|verificado (o una entrada nueva del
# Histórico) lleva en «Resuelto» una referencia que RESUELVE: una ruta del índice (`archivo` o
# `archivo:línea`) o un commit del historial. Que además DEMUESTRE la resolución lo juzga el revisor.
# QUÉ PUEDE CAMBIAR SIN `Ref: I<n>`: solo el rastro y la plantilla (SIN_REVISION, abajo). Todo
# lo demás es código del producto y entra únicamente con `Ref: I<n>` y su recibo: un `Cierra:`
# o un `Ref: F#` no acreditan revisión del código. Emergencia: git commit --no-verify.
#
# REPLAY (CI): con REV=<sha> valida ESE commit ya hecho en lugar del índice (mensaje, árbol
# e historial anteriores a él); así scripts/pruebas/validar_historial.sh detecta en el remoto
# lo que un --no-verify local se saltó. El argumento $1 se ignora en ese modo.
msg_file="$1"
FAIL=0
# Auxiliares: en el hook local, los del repositorio; en el replay anclado (REV y METODO_DIR, que
# fija scripts/pruebas/validar_historial.sh --metodo), los de esa carpeta. Nunca se heredan fuera de REV.
[ -n "${REV:-}" ] || unset METODO_DIR
MET=${METODO_DIR:-.}
fail() { echo "✗ commit-msg: $1" >&2; FAIL=1; }
if [ -n "${REV:-}" ]; then
  REV=$(git rev-parse --verify "$REV^{commit}" 2>/dev/null) || { fail "REV=$REV no es un commit"; exit 1; }
  msg_file=$(mktemp 2>/dev/null || mktemp -t msg); git log -1 --format=%B "$REV" > "$msg_file"
  BASE=$(git rev-parse --verify -q "$REV^" 2>/dev/null || git hash-object -t tree /dev/null)
  idx() { git show "$REV:$1" 2>/dev/null; }
  HUELLA=$(sh "$MET/scripts/huella.sh" commit "$REV" 2>/dev/null)
  cambios=$(git -c core.quotePath=false diff --name-only --no-renames "$BASE" "$REV")
else
  BASE=$(git rev-parse --verify -q HEAD 2>/dev/null || git hash-object -t tree /dev/null)
  idx() { git show ":$1" 2>/dev/null || cat "$1" 2>/dev/null; }
  HUELLA=$(sh "$MET/scripts/huella.sh" indice 2>/dev/null)
  cambios=$(git -c core.quotePath=false diff --cached --name-only --no-renames "$BASE")
fi
# ¿BASE es un commit (hay historial) o el árbol vacío?
HAY_HISTORIAL=0; git rev-parse --verify -q "$BASE^{commit}" >/dev/null 2>&1 && HAY_HISTORIAL=1

# --- Merges -----------------------------------------------------------------------------------
# Un merge LIMPIO (su árbol es exactamente la fusión automática de sus dos padres) no añade
# contenido: lo que trae ya pasó por sus propios commits. Se acepta sin trailer. Si el árbol
# DIFIERE de esa fusión (resolución de conflictos, archivos añadidos o cambiados durante el
# merge, más de dos padres), el merge introduce contenido y se trata como cualquier commit:
# trailer obligatorio y, si lo añadido toca código, `Ref: I<n>` con recibo sobre su huella.
# La fusión automática se calcula con un índice temporal (read-tree a tres vías y merge-file
# para lo que ambos lados tocaron), sin tocar el índice ni el árbol de trabajo; no depende de
# `git merge-tree --write-tree` (git ≥ 2.38).
arbol_fusion_automatica() {  # $1 $2 = padres → imprime el árbol de la fusión limpia, o nada
  [ "$#" -eq 2 ] || return 0
  mb=$(git merge-base "$1" "$2" 2>/dev/null) || return 0
  ti=$(mktemp 2>/dev/null || mktemp -t fusion); rm -f "$ti"
  if ! GIT_INDEX_FILE="$ti" git read-tree -i -m --aggressive "$mb" "$1" "$2" 2>/dev/null; then rm -f "$ti"; return 0; fi
  ok_f=1
  GIT_INDEX_FILE="$ti" git ls-files -u | cut -f2 | sort -u > "$ti.u"
  while IFS= read -r p; do
    b1=$(GIT_INDEX_FILE="$ti" git ls-files -u -- "$p" | awk '$3==1{print $2}')
    b2=$(GIT_INDEX_FILE="$ti" git ls-files -u -- "$p" | awk '$3==2{print $2}')
    b3=$(GIT_INDEX_FILE="$ti" git ls-files -u -- "$p" | awk '$3==3{print $2}')
    md=$(GIT_INDEX_FILE="$ti" git ls-files -u -- "$p" | awk '$3==2{print $1}')
    [ -n "$b1" ] && [ -n "$b2" ] && [ -n "$b3" ] || { ok_f=0; break; }   # alta/baja en conflicto
    git cat-file blob "$b1" > "$ti.1"; git cat-file blob "$b2" > "$ti.2"; git cat-file blob "$b3" > "$ti.3"
    git merge-file -q -p "$ti.2" "$ti.1" "$ti.3" > "$ti.m" 2>/dev/null || { ok_f=0; break; }
    nb=$(git hash-object -w "$ti.m")
    GIT_INDEX_FILE="$ti" git update-index --force-remove -- "$p" && GIT_INDEX_FILE="$ti" git update-index --add --cacheinfo "$md,$nb,$p" || { ok_f=0; break; }
  done < "$ti.u"
  [ "$ok_f" -eq 1 ] && GIT_INDEX_FILE="$ti" git write-tree 2>/dev/null
  rm -f "$ti" "$ti.u" "$ti.1" "$ti.2" "$ti.3" "$ti.m"
}
padres=""; cand=""
if [ -n "${REV:-}" ]; then
  padres=$(git rev-list --parents -n 1 "$REV" | cut -d' ' -f2-)
  cand=$(git rev-parse "$REV^{tree}")
else
  mh=$(git rev-parse --git-path MERGE_HEAD)
  [ -f "$mh" ] && { padres="$(git rev-parse HEAD) $(tr '\n' ' ' < "$mh")"; cand=$(git write-tree); }
fi
MERGE_SUCIO=""; MERGE_LIMPIO=0
if [ "$(printf '%s\n' $padres | grep -c .)" -ge 2 ]; then
  limpio=$(arbol_fusion_automatica $padres)
  # Merge limpio: nada nuevo que acreditar POR COMMIT (sin trailer, sin exigir Ref: I<n> al código que
  # trae), pero el RESULTADO integrado sí se juzga como estado: no entra a F5 sin Ref: F5 (el recibo del
  # conjunto de la rama corresponde a otro árbol) y ningún hallazgo desaparece respecto del primer padre.
  [ -n "$limpio" ] && [ "$limpio" = "$cand" ] && MERGE_LIMPIO=1
  if [ "$MERGE_LIMPIO" -eq 1 ]; then :; elif [ -n "$limpio" ]; then
    # Lo que el merge añade por su cuenta es la diferencia con la fusión automática.
    cambios=$(git -c core.quotePath=false diff --name-only --no-renames "$limpio" "$cand")
    MERGE_SUCIO=$(printf '%s\n' "$cambios" | head -3 | tr '\n' ' ')
  else
    MERGE_SUCIO="(fusión con conflictos o de más de dos padres: todo su contenido cuenta)"
  fi
fi

trailers=$(grep -E '^(Ref|Cierra):' "$msg_file")
[ -n "$trailers" ] || [ -z "$MERGE_SUCIO" ] || fail "el merge cambia contenido respecto de la fusión automática de sus padres (${MERGE_SUCIO}…): una resolución de conflictos o un archivo añadido al fusionar es contenido nuevo; commitéalo con su trailer (y 'Ref: I<n>' con recibo si toca código), o deja el merge limpio."
[ -n "$trailers" ] || [ -n "$MERGE_SUCIO" ] || [ "$MERGE_LIMPIO" -eq 1 ] || fail "falta el trailer de enlace. Usa 'Ref: F1|F2|F4|F5', 'Ref: I3', 'Ref: hito:I1-I3', o 'Cierra: R-I3.1' / 'R-S3.1' / 'R-F4.1' / 'R-SF4.1' / 'R-E.1' (docs/convenciones.md §Git)."
[ -n "$HUELLA" ] || fail "no pude calcular la huella (scripts/huella.sh)."

# Rutas que un commit puede tocar SIN `Ref: I<n>`: el rastro documental, las entradas, las
# notas locales, la instrumentación del método y la configuración del repositorio. Ampliarla es
# una decisión (ADR), no un atajo. Una carpeta que mezcla método y producto no se exime entera:
# - METODO: la instrumentación del método, archivo por archivo. De .githooks/ solo sus tres hooks;
#   un hook propio del proyecto (pre-push, hooks previos integrados) es código y entra con Ref: I<n>.
#   De scripts/pruebas/, solo las regresiones y el validador; las pruebas propias son producto.
# - .github/: además de metodo.yml, solo los documentos puramente informativos, nombrados uno a uno
#   (README, guías de contribución, conducta, seguridad, soporte y plantillas de issue y de PR en
#   Markdown). Los demás workflows, acciones y archivos de .github/ son configuración operativa del
#   producto (CI, despliegue, dependencias, propietarios, instrucciones de agentes).
METODO='^(\.github/workflows/metodo\.yml|\.githooks/(commit-msg|pre-commit|pre-merge-commit)|scripts/pruebas/(regresion|regresion-suite|regresion-adopcion|validar_historial|replay_anclado)\.sh|scripts/(check_docs|adoptar|buscar|huella|recibos|trazabilidad|guardas)\.sh|scripts/(consumo|suite|contrato|fallos_previos)\.py)$'
SIN_REVISION='^(docs|contexto|mejoras|\.claude|\.codex|\.agents)/|^\.github/((README|CONTRIBUTING|CODE_OF_CONDUCT|SECURITY|SUPPORT|PULL_REQUEST_TEMPLATE|pull_request_template)\.md|(ISSUE_TEMPLATE|PULL_REQUEST_TEMPLATE)/[^/]+\.md)$|^(README\.md|AGENTS\.md|CLAUDE\.md|\.gitignore|\.gitattributes|\.editorconfig|\.env\.example|scripts/check\.sh)$|(^|/)\.env\.example$|'"$METODO"
# Siempre producto aunque viva en una carpeta del rastro: CODEOWNERS decide quién aprueba y GitHub
# lo lee de .github/, la raíz o docs/ (las dos primeras ya están fuera de SIN_REVISION).
SIEMPRE_REVISION='^docs/CODEOWNERS$'
# Un .env.example (plantilla sin valores) en cualquier carpeta es configuración, como en guardas.sh.
# Quitar un .env versionado es la corrección de un secreto, no código: no exige `Ref: I<n>`.
en_candidato() { if [ -n "${cand:-}" ]; then git cat-file -e "$cand:$1" 2>/dev/null; else git ls-files --error-unmatch -- "$1" >/dev/null 2>&1; fi; }
# Límite conocido, defecto pendiente (no es un riesgo aceptado): un archivo propio de un proyecto
# adoptado que se llama como uno de METODO («Omitidos por colisión» de contexto/adopcion.md) queda
# exento por su nombre. Este hook no comprueba la procedencia; su diseño va aparte.
# scripts/check.sh con el contrato «# contrato-check: 1» (en el check_docs.sh del candidato o de algún padre): no
# se exime por nombre; lo clasifica más abajo «Cuerpo de scripts/check.sh». Sin el marcador, la regla anterior.
# El marcador se lee de los blobs versionados, con tres resultados: 0 lo declara; 1 no lo declara o no hay
# check_docs.sh; 2 no se pudo leer. Un error no equivale a «sin marcador»: se rechaza si el commit toca check.sh.
marcador_check() {  # <commit|INDICE>
  if [ "$1" = INDICE ]; then e=$(git ls-files -s -- scripts/check_docs.sh) || return 2
  else e=$(git ls-tree "$1" -- scripts/check_docs.sh) || return 2; fi
  [ -n "$e" ] || return 1
  id=$(printf '%s' "$e" | awk '{ if ($2 == "blob") print $3; else print $2 }')
  b=$(git cat-file blob "$id" 2>/dev/null) || return 2
  printf '%s\n' "$b" | grep -qx '# contrato-check: 1'
}
padres_o_base=${padres:-$([ "$HAY_HISTORIAL" -eq 1 ] && printf '%s' "$BASE")}
CONTRATO_CHECK=0; err_marcador=""
for r in "${REV:-INDICE}" $padres_o_base; do
  marcador_check "$r"
  case $? in 0) CONTRATO_CHECK=1 ;; 1) ;; *) err_marcador="${err_marcador:+$err_marcador, }$([ "$r" = INDICE ] && echo 'el índice' || git rev-parse --short "$r" 2>/dev/null || printf '%s' "$r")" ;; esac
done
if [ -n "$err_marcador" ] && printf '%s\n' "$cambios" | grep -qx 'scripts/check.sh'; then
  fail "no pude leer scripts/check_docs.sh (en $err_marcador) para saber si rige «# contrato-check: 1»: sin saberlo no se puede decidir si el cuerpo de scripts/check.sh exige revisión, y un error no equivale a «sin marcador»."
fi
codigo=$(printf '%s\n' "$cambios" | grep . | while IFS= read -r f; do
  [ "$f" = scripts/check.sh ] && [ "$CONTRATO_CHECK" -eq 1 ] && continue
  if printf '%s\n' "$f" | grep -qE "$SIEMPRE_REVISION"; then printf '%s\n' "$f"; continue; fi
  printf '%s\n' "$f" | grep -qE "$SIN_REVISION" && continue
  printf '%s' "$f" | grep -qE '(^|/)\.env($|\.)' && ! en_candidato "$f" && continue
  printf '%s\n' "$f"
done)

# Recibos: docs/revisiones.log del índice, leído por el parser ÚNICO (scripts/recibos.sh),
# el mismo que usa check_docs: comentarios ignorados, claves únicas, tipos y relaciones
# (PASA ⇒ bloqueantes=0). Un registro con una línea inválida no entrega ningún recibo.
LOGTMP=$(mktemp 2>/dev/null || mktemp -t recibos); trap 'rm -f "$LOGTMP"' EXIT INT TERM
idx docs/revisiones.log > "$LOGTMP"
# Contrato de recibos con que se hizo el commit validado: solo en el REPLAY (REV) y derivado de
# ESE commit; en local nunca hay excepción, venga lo que venga en el entorno.
PREVIO=""
if [ -n "${REV:-}" ] && ! git show "$REV:scripts/recibos.sh" 2>/dev/null | grep -q 'contrato-recibos: 2'; then PREVIO=previo; fi
sh "$MET/scripts/recibos.sh" validar "$LOGTMP" $PREVIO || fail "docs/revisiones.log tiene líneas inválidas (arriba): corrígelas; mientras tanto ningún recibo cuenta."
campo() { printf '%s' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1; }
ultimo_recibo() { sh "$MET/scripts/recibos.sh" ultimo "$1" "$2" "$3" "$LOGTMP" $PREVIO 2>/dev/null; }
exige_recibo() {  # $1 rol $2 tipo $3 alcance $4 descripción para el error → 0 si vigente
  rec=$(ultimo_recibo "$1" "$2" "$3")
  if [ -z "$rec" ]; then
    fail "$4: no hay recibo válido de $1 ($2 $3) en docs/revisiones.log. Formato: fecha=… rol=$1 tipo=$2 alcance=$3 veredicto=PASA bloqueantes=0 [seguridad=requerida|no-aplica] huella=$HUELLA ejecutor=… modalidad=lectura|experimentos filtro=comprobado|desactivado|sin-verificar aislamiento=ninguno|sandbox-configurado|sandbox-verificado [evidencia=docs/revisiones/<id>@<huella>] (gramática: scripts/recibos.sh)"; return 1
  fi
  v=$(campo "$rec" veredicto); h=$(campo "$rec" huella)
  [ "$v" = "PASA" ] || { fail "$4: la última revisión de $1 ($2 $3) fue $v, no PASA."; return 1; }
  [ "$h" = "$HUELLA" ] || { fail "$4: el recibo de $1 ($2 $3) tiene huella $h y lo que se commitea tiene $HUELLA: el contenido cambió después de la revisión; repítela."; return 1; }
  return 0
}
exige_seguridad_si_aplica() {  # $1 recibo del juez  $2 tipo  $3 alcance
  s=$(campo "$1" seguridad)
  case "$s" in
    no-aplica) return 0 ;;
    requerida) exige_recibo juez-seguridad "$2" "$3" "el recibo del juez marca seguridad=requerida" ;;
    *) fail "el recibo del juez ($2 $3) no declara seguridad=requerida|no-aplica."; return 1 ;;
  esac
}
exige_conjunto() {  # F4 y F5 exigen lo MISMO: conjunto PASA vigente + seguridad si requerida
  rec=$(ultimo_recibo juez-conjunto conjunto F4)
  exige_recibo juez-conjunto conjunto F4 "$1" && exige_seguridad_si_aplica "$rec" conjunto F4
}
# Lectura de docs/trazabilidad.md con el lector ÚNICO (scripts/trazabilidad.sh, el mismo del
# doctor): filas C/E/R por encabezado y columna, Histórico como Estado verificado|desconocido.
# Incrementos del plan con el lector ÚNICO (`check_docs.sh plan`, la misma gramática del doctor).
en_plan() { idx docs/plan.md | sh "$MET/scripts/check_docs.sh" plan - | awk -v i="$1" '$1=="I" && $2==i {f=1} END {exit f ? 0 : 1}'; }
filas() { idx docs/trazabilidad.md | sh "$MET/scripts/trazabilidad.sh" - | awk '$1 ~ /^(C|E|R|H)$/ {print $2, $4}'; }
estado_fila() { filas | awk -v id="$1" '$1==id {print $2; exit}'; }
abiertos() { filas | awk -v re="$1" '$1 ~ re && $2=="abierto" {print $1}' | tr '\n' ' '; }
# ¿Hay en el historial (antes de este commit) un commit cuyo trailer sea exactamente $1?
commit_con_trailer() {  # $1 regex ERE del trailer completo, p. ej. '^Ref: *I3 *$'
  [ "$HAY_HISTORIAL" -eq 1 ] || return 1
  git log -1 --format=%H -E --grep="$1" "$BASE" 2>/dev/null | grep -q .
}
# Incrementos cerrados desde el último hito: commits `Ref: I<k>` distintos después del último
# commit `Ref: hito:…` (o desde el inicio si no hay hito). Más este, si es un `Ref: I`.
cerrados_desde_hito() {
  [ "$HAY_HISTORIAL" -eq 1 ] || return 0
  hc=$(git log -1 --format=%H -E --grep='^Ref:[[:space:]]*hito:I[0-9]+-I[0-9]+[[:space:]]*$' "$BASE" 2>/dev/null)
  git log --format=%B ${hc:+"$hc.."}"$BASE" 2>/dev/null | grep -oE '^Ref:[[:space:]]*I[0-9]+[[:space:]]*$' | grep -oE 'I[0-9]+' | sort -u
}
# Contrato revisado de <INDICE|commit> con el lector único (scripts/contrato.py, el mismo de check_docs):
# registros C, ORO, REF (archivo referenciado y su blob) y ERR. Si no puede leer, el código no es 0.
contrato() { python3 -I "$MET/scripts/contrato.py" objetos "$1"; }
# El candidato declara su versión del contrato en SU scripts/check_docs.sh (la línea exacta
# «# contrato-set-de-oro: 1»). Sin ella (un commit anterior a M03, en el replay) rige la comparación de
# entonces, conservada tal cual; con ella, solo el lector, y un error de lectura FALLA (nunca vuelve a la
# previa). Si el último `Ref: F2` no vale como referencia con el marcador, el trabajo dependiente exige
# migrarlo con una reentrada de alcance F2 completo (reentrada:C<n> no basta); si vale, rige la reentrada
# ordinaria. El marcador identifica la versión; no autentica a los validadores. guardas.sh (regla 8)
# impide retirarlo una vez instalado.
m03() { idx scripts/check_docs.sh | grep -qx '# contrato-set-de-oro: 1'; }
contrato_previo() { awk '/^- C[0-9]+:/ {print; next} /^## / {s=($0 ~ /^## Set de oro/); next} s {print}' | sed 's/[[:space:]]*$//' | grep -v '^$'; }
base_metodo() { idx docs/convenciones.md | sed -nE 's/^- \*\*Base del método:\*\* `?([0-9a-f]{7,40})`?[[:space:]]*$/\1/p' | head -1; }
# Último commit `Ref: F2` alcanzable desde $1 o BASE (tras la base del método, si la hay), con tres resultados:
# 0 lo hay (F2_SHA); 1 la búsqueda recorrió la historia completa sin encontrarlo; 2 no se pudo determinar
# (F2_ERR): git falló o, sin coincidencia, la historia está recortada (clon superficial).
busca_f2() {
  F2_SHA=""; F2_ERR=""
  [ "$HAY_HISTORIAL" -eq 1 ] || return 1
  bm=$(base_metodo); excl=""
  [ -n "$bm" ] && git rev-parse --verify -q "$bm^{commit}" >/dev/null 2>&1 && excl="^$bm"
  # shellcheck disable=SC2086
  F2_SHA=$(git log -1 --format=%H -E --grep='^Ref:[[:space:]]*F2[[:space:]]*$' "${1:-$BASE}" $excl 2>/dev/null) || { F2_SHA=""; F2_ERR="git log terminó con error"; return 2; }
  [ -n "$F2_SHA" ] && return 0
  [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = false ] || { F2_ERR="la historia está recortada (clon superficial) o no se pudo comprobar si lo está"; return 2; }
  return 1
}
ultimo_f2() { busca_f2 "$@" && printf '%s\n' "$F2_SHA"; }  # sha; el código de busca_f2 (1 o 2) si no
# ¿Resuelve una referencia? Una ruta del candidato (`archivo` o `archivo:línea`, con o sin acentos
# graves, paréntesis o coma pegados) o un sha de 7–40 hex que es ancestro de BASE.
referencia_resuelve() {  # $1 texto de la celda → 0 si algún token resuelve
  for t in $(printf '%s' "$1" | tr '·,;()`' '      '); do
    case "$t" in
      */*|*.*) r=$(printf '%s' "$t" | sed -E 's/:[0-9]+(-[0-9]+)?$//'); en_candidato "$r" && return 0 ;;
    esac
    if printf '%s' "$t" | grep -qxE '[0-9a-f]{7,40}'; then
      [ "$HAY_HISTORIAL" -eq 1 ] && git merge-base --is-ancestor "$t" "$BASE" 2>/dev/null && return 0
    fi
  done
  return 1
}

cierre=0; con_incremento=0; dependiente=0; con_f2=0; con_f5=0
IFS='
'
for line in $trailers; do
  if printf '%s' "$line" | grep -qE '^Ref:[[:space:]]*F[1245][[:space:]]*$'; then
    f=$(printf '%s' "$line" | grep -oE 'F[1245]')
    case "$f" in
      F2)
        con_f2=1
        if exige_recibo revisor-funcional encuadre F2 "'$line'"; then
          # Una reentrada se acredita sobre un criterio que EXISTE en el encuadre y es el ÚNICO que
          # cambió respecto del contrato revisado anterior (varios criterios ⇒ alcance F2 completo).
          a=$(campo "$(ultimo_recibo revisor-funcional encuadre F2)" alcance)
          case "$a" in reentrada:C*)
            c=${a#reentrada:}
            idx docs/encuadre.md | grep -qE "^- $c:" || fail "'$line': el recibo del revisor funcional es de alcance $a, pero $c no está definido en docs/encuadre.md ('- $c: …')."
            if f2p=$(ultimo_f2); then
              # Con el marcador, un registro ERR (aunque el lector salga con 0) no acota nada: FALLA. Si el
              # último F2 no vale como referencia, la migración revisa el contrato completo (alcance F2).
              cambiados=""
              if ! m03; then
                cambiados=$( { git show "$f2p:docs/encuadre.md" 2>/dev/null | grep -E '^- C[0-9]+:' ; idx docs/encuadre.md | grep -E '^- C[0-9]+:' ; } | sed 's/[[:space:]]*$//' | sort | uniq -u | grep -oE '^- C[0-9]+' | grep -oE 'C[0-9]+' | sort -u)
              elif ! c2=$(contrato "$f2p") || ! cn=$(contrato "${REV:-INDICE}"); then
                fail "'$line': no pude leer el contrato con scripts/contrato.py (python3 -I) para acotar la reentrada."
              elif printf '%s\n' "$cn" | grep -q '^ERR	'; then
                fail "'$line': el contrato de docs/encuadre.md no se puede leer ($(printf '%s\n' "$cn" | sed -n 's/^ERR	//p' | head -3 | tr '\n' '|')); una reentrada no se acota sobre un contrato ilegible."
              elif printf '%s\n' "$c2" | grep -q '^ERR	'; then
                fail "'$line': el último contrato revisado (commit $(git rev-parse --short "$f2p"), 'Ref: F2') no vale como referencia con «contrato-set-de-oro: 1» ($(printf '%s\n' "$c2" | sed -n 's/^ERR	//p' | head -3 | tr '\n' '|')): la migración revisa el contrato completo, así que el recibo del revisor funcional es de alcance F2, no $a."
              else
                cambiados=$( { printf '%s\n' "$c2"; printf '%s\n' "$cn"; } | grep '^C	' | sort | uniq -u | grep -oE '^C	- C[0-9]+' | grep -oE 'C[0-9]+' | sort -u)
              fi
              for k in $cambiados; do
                [ "$k" = "$c" ] || fail "'$line': el recibo de reentrada cubre $c, pero también cambió $k respecto del contrato revisado (commit $(git rev-parse --short "$f2p")); con varios criterios el alcance de la revisión es F2 completo."
              done
            else
              fail "'$line': recibo de alcance $a (reentrada) sin ningún commit 'Ref: F2' anterior$( [ -n "$(base_metodo)" ] && printf ' posterior a la Base del método'); una reentrada supone un contrato ya revisado."
            fi ;;
          esac
        fi
        ab=$(abiertos '^R-E[.][0-9]+$')
        [ -z "$ab" ] || fail "'$line' con vacío(s) en Estado abierto en docs/trazabilidad.md ($ab): el gate de diseño no se cruza con vacíos abiertos." ;;
      F4) cierre=1; dependiente=1; exige_conjunto "'$line'" || : ;;
      F5) cierre=1; dependiente=1; con_f5=1; exige_conjunto "'$line' (el cierre exige que la validación del conjunto, con su seguridad, siga vigente)" || : ;;
    esac
  elif printf '%s' "$line" | grep -qE '^Ref:[[:space:]]*hito:I[0-9]+-I[0-9]+[[:space:]]*$'; then
    dependiente=1
    a=$(printf '%s' "$line" | grep -oE 'hito:I[0-9]+-I[0-9]+')
    ia=$(printf '%s' "$a" | sed -E 's/hito:I([0-9]+)-I([0-9]+)/\1/'); ib=$(printf '%s' "$a" | sed -E 's/hito:I([0-9]+)-I([0-9]+)/\2/')
    [ "$ia" -le "$ib" ] || fail "'$line': rango invertido."
    k=$ia
    while [ "$k" -le "$ib" ]; do
      en_plan "I$k" || fail "'$line': I$k no existe como incremento en docs/plan.md; el hito cubre incrementos reales."
      commit_con_trailer "^Ref:[[:space:]]*I$k[[:space:]]*\$" || fail "'$line': I$k no tiene commit 'Ref: I$k' en el historial; el hito revisa lo ensamblado hasta aquí, no lo que falta por cerrar."
      k=$((k+1))
    done
    # El hito revisa TODO lo cerrado desde el anterior: un rango que deja fuera un incremento
    # cerrado (o un hito sin incrementos nuevos) reiniciaría el contador sin revisarlo.
    nuevos=$(cerrados_desde_hito)
    [ -n "$nuevos" ] || fail "'$line': no hay incrementos cerrados desde el último commit 'Ref: hito:…'; un hito sin incrementos nuevos no revisa nada."
    for k in $nuevos; do
      n=${k#I}
      { [ "$n" -ge "$ia" ] && [ "$n" -le "$ib" ]; } || fail "'$line': $k se cerró después del último hito y queda fuera del rango; el hito cubre todo lo cerrado desde el anterior (usa hito:I<a>-I<b> que lo incluya)."
    done
    rec=$(ultimo_recibo juez-conjunto hito "$a")
    if exige_recibo juez-conjunto hito "$a" "'$line'" && exige_seguridad_si_aplica "$rec" hito "$a"; then
      # cubre= y excluye= nombran criterios que EXISTEN en el encuadre y no se solapan.
      # Una lista C1,C2 se parte en LÍNEAS: dentro de este bucle IFS es el salto de línea
      # (los trailers se recorren por línea), así que separarla con espacios dejaría 'C1 C2'
      # como un solo identificador.
      # Forma cerrada ANTES de partir: cubre=C<n>(,C<n>)*; excluye= es exactamente 'ninguno'
      # o esa misma lista (sin vacíos, sin mezclar el centinela con criterios).
      printf '%s' "$(campo "$rec" cubre)" | grep -qxE 'C[0-9]+(,C[0-9]+)*' \
        || fail "'$line': cubre='$(campo "$rec" cubre)' del recibo del hito no tiene la forma C<n>[,C<n>…] (sin vacíos ni 'ninguno')."
      printf '%s' "$(campo "$rec" excluye)" | grep -qxE 'ninguno|C[0-9]+(,C[0-9]+)*' \
        || fail "'$line': excluye='$(campo "$rec" excluye)' del recibo del hito no es 'ninguno' ni una lista C<n>[,C<n>…] (sin vacíos ni mezclas)."
      cu=$(campo "$rec" cubre | tr ',' '\n' | grep .); ex=$(campo "$rec" excluye | tr ',' '\n' | grep .)
      for c in $cu $ex; do
        [ "$c" = "ninguno" ] && continue
        printf '%s' "$c" | grep -qE '^C[0-9]+$' || { fail "'$line': el recibo del hito nombra '$c' en cubre=/excluye=; se esperan criterios C<n> separados por coma (o excluye=ninguno)."; continue; }
        idx docs/encuadre.md | grep -qE "^- $c:" || fail "'$line': el recibo del hito nombra $c, que no está definido en docs/encuadre.md."
      done
      for c in $cu; do for d in $ex; do [ "$c" = "$d" ] && fail "'$line': $c aparece a la vez en cubre= y excluye= del recibo del hito."; done; done
      # Cada lista es un CONJUNTO: un criterio repetido suele ser una errata (se quiso nombrar
      # otro), así que se rechaza en vez de normalizarlo en silencio.
      for lst in cubre excluye; do
        rep=$(campo "$rec" "$lst" | tr ',' '\n' | grep . | sort | uniq -d | tr '\n' ' ')
        [ -z "$rep" ] || fail "'$line': $lst= del recibo del hito repite $rep; cada criterio va una sola vez (¿se quiso nombrar otro?)."
      done
      # cubre= y excluye= PARTEN los criterios del encuadre: cubre= no está vacío ni es
      # 'ninguno'; todo criterio va en una de las dos; uno ya construido (todos los
      # incrementos de su fila de Cobertura tienen commit) va en cubre=; excluye= es solo
      # para lo futuro.
      printf '%s\n' "$cu" | grep -qxE 'C[0-9]+' || fail "'$line': cubre= del recibo del hito no nombra ningún criterio; un hito revisa al menos un criterio construido ('ninguno' solo vale en excluye=)."
      cov=$(idx docs/trazabilidad.md | sh "$MET/scripts/trazabilidad.sh" - | awk '$1=="C" {print $2, $3}')
      for c in $(idx docs/encuadre.md | grep -oE '^- C[0-9]+:' | grep -oE 'C[0-9]+' | sort -u); do
        en_cu=0; en_ex=0
        printf '%s\n' "$cu" | grep -qx "$c" && en_cu=1
        printf '%s\n' "$ex" | grep -qx "$c" && en_ex=1
        [ $en_cu -eq 1 ] || [ $en_ex -eq 1 ] || { fail "'$line': $c no está ni en cubre= ni en excluye= del recibo del hito; cada criterio del encuadre se nombra en una de las dos."; continue; }
        incs=$(printf '%s\n' "$cov" | awk -v c="$c" '$1==c {print $2}' | grep -oE 'I[0-9]+' | sort -u)
        [ -n "$incs" ] || continue
        hecho=1
        for k in $incs; do commit_con_trailer "^Ref:[[:space:]]*$k[[:space:]]*\$" || hecho=0; done
        [ $hecho -eq 1 ] && [ $en_ex -eq 1 ] && fail "'$line': $c está en excluye= pero ya está construido ($(printf '%s' "$incs" | tr '\n' ' ')con commit); excluye= es solo para criterios de incrementos futuros: va en cubre=."
      done
    fi
  elif printf '%s' "$line" | grep -qE '^Ref:[[:space:]]*I[0-9]+[[:space:]]*$'; then
    con_incremento=1; dependiente=1
    id=$(printf '%s' "$line" | grep -oE 'I[0-9]+')
    en_plan "$id" \
      || fail "'$line' pero $id no existe como incremento en docs/plan.md (formato: '- [ ] $id «alias» — …')."
    rec=$(ultimo_recibo juez-codigo incremento "$id")
    exige_recibo juez-codigo incremento "$id" "'$line'" && exige_seguridad_si_aplica "$rec" incremento "$id"
    # Un incremento no se cierra con sus propios bloqueantes abiertos (código o seguridad).
    ab=$(abiertos "^R-(I|S)${id#I}[.][0-9]+$")
    [ -z "$ab" ] || fail "'$line' con hallazgo(s) de $id en Estado abierto en docs/trazabilidad.md ($ab): resuélvelos (fila en resuelto, con su evidencia) antes de cerrar el incremento."
    # El avance queda a la vista en el mismo commit: la casilla del plan y el resumen vivo.
    idx docs/plan.md | sh "$MET/scripts/check_docs.sh" plan - | awk -v i="$id" '$1=="I" && $2==i && $3=="hecho" {f=1} END {exit f ? 0 : 1}' \
      || fail "'$line' pero $id sigue como '- [ ]' en docs/plan.md: márcalo '- [x] $id' antes de pedir la revisión final (plan.md entra en la huella: marcarlo después caduca el recibo)."
    printf '%s\n' "$cambios" | grep -qx 'docs/estado.md' \
      || fail "'$line' sin regenerar docs/estado.md: el cierre de cada incremento lo regenera (fase, próximo paso y pendiente) en este mismo commit."
    # Contador del hito (AGENTS.md §2): tres incrementos cerrados desde el último hito, más este.
    n=$( { cerrados_desde_hito; echo "$id"; } | sort -u | grep -c .)
    [ "$n" -le 3 ] || fail "'$line': con este serían $n incrementos cerrados desde el último commit 'Ref: hito:…' ($( { cerrados_desde_hito; echo "$id"; } | sort -u | tr '\n' ' ')); el hito (pasada del juez de conjunto sobre lo ensamblado y commit 'Ref: hito:I<a>-I<b>') es obligatorio antes de cerrar el cuarto."
  elif printf '%s' "$line" | grep -qE '^Cierra:[[:space:]]*R-(E\.[0-9]+|I[0-9]+\.[0-9]+|S[0-9]+\.[0-9]+|F4\.[0-9]+|SF4\.[0-9]+)[[:space:]]*$'; then
    id=$(printf '%s' "$line" | grep -oE 'R-(E|I[0-9]+|S[0-9]+|F4|SF4)\.[0-9]+')
    est=$(estado_fila "$id")
    [ -n "$est" ] || fail "'$line' pero $id no tiene fila en docs/trazabilidad.md (tablas o Histórico). Un Cierra: afirma sobre otro documento: primero la fila, después el commit."
    case "$est" in ""|resuelto|verificado) ;; *) fail "'$line' pero $id sigue en Estado '$est': un Cierra: exige resuelto (con su mutación escrita) o verificado." ;; esac
  else
    fail "trailer malformado o familia desconocida: '$line'. Gramática: Ref: F1|F2|F4|F5 · Ref: I<n> · Ref: hito:I<a>-I<b> · Cierra: R-E.<n> | R-I<i>.<n> | R-S<i>.<n> | R-F4.<n> | R-SF4.<n>."
  fi
done
unset IFS

# --- Contrato revisado: el trabajo dependiente se ata al último `Ref: F2`, no a la fase ---------
if [ "$dependiente" -eq 1 ] && [ "$con_f2" -eq 0 ]; then
  if f2=$(ultimo_f2); then
    # Sin el marcador, la comparación de entonces (con contrato_previo). Con él, una sección ausente,
    # duplicada o no reconocida, o una referencia inválida, no es un contrato vacío: FALLA.
    if ! m03; then
      ca=$(git show "$f2:docs/encuadre.md" 2>/dev/null | contrato_previo); cb=$(idx docs/encuadre.md | contrato_previo)
      [ "$ca" = "$cb" ] || fail "los criterios o el set de oro de docs/encuadre.md no son los del último contrato revisado (commit $(git rev-parse --short "$f2"), 'Ref: F2'); difiere: $( { printf '%s\n' "$ca"; printf '%s\n' "$cb"; } | sort | uniq -u | head -2 | cut -c1-60 | tr '\n' '|'). Un cambio de la verdad acordada reentra por el encuadre (docs/arranque.md §Reentrada): ADR, revisor funcional y commit 'Ref: F2' (alcance F2, o reentrada:C<n> si solo cambió ese criterio) antes de cerrar trabajo que depende de ella."
    elif ! ca=$(contrato "$f2") || ! cb=$(contrato "${REV:-INDICE}"); then
      fail "no pude leer el contrato revisado con scripts/contrato.py (python3 -I); sin lector no hay comparación."
    elif printf '%s\n' "$cb" | grep -q '^ERR	'; then
      fail "el contrato de docs/encuadre.md no se puede leer: $(printf '%s\n' "$cb" | sed -n 's/^ERR	//p' | head -3 | tr '\n' '|'). No es un contrato vacío ni el último contrato revisado (commit $(git rev-parse --short "$f2"), 'Ref: F2'): corrige la estructura o la referencia, y si cambia la verdad acordada, reentra por el encuadre (docs/arranque.md §Reentrada)."
    elif printf '%s\n' "$ca" | grep -q '^ERR	'; then
      fail "el último contrato revisado (commit $(git rev-parse --short "$f2"), 'Ref: F2') no vale como referencia con «contrato-set-de-oro: 1»: $(printf '%s\n' "$ca" | sed -n 's/^ERR	//p' | head -3 | tr '\n' '|'). Se migra hacia adelante, sin reescribir historia: reentrada por el encuadre con revisor funcional y un commit 'Ref: F2' cuyo docs/encuadre.md ya cumpla la estructura (docs/arranque.md §Reentrada); después, el trabajo dependiente se ata a ese F2."
    else
      [ "$ca" = "$cb" ] || fail "los criterios, el set de oro o los archivos que referencia (docs/encuadre.md) no son los del último contrato revisado (commit $(git rev-parse --short "$f2"), 'Ref: F2'); difiere: $( { printf '%s\n' "$ca"; printf '%s\n' "$cb"; } | sort | uniq -u | head -2 | cut -c1-80 | tr '\n' '|'). Un cambio de la verdad acordada reentra por el encuadre (docs/arranque.md §Reentrada): ADR, revisor funcional y commit 'Ref: F2' (alcance F2, o reentrada:C<n> si solo cambió ese criterio) antes de cerrar trabajo que depende de ella."
    fi
  else
    fail "el commit cierra trabajo que depende de los criterios (Ref: I<n> | hito | F4 | F5) pero no hay ningún commit 'Ref: F2' en el historial$( [ -n "$(base_metodo)" ] && printf ' posterior a la Base del método'): sin plan aprobado no hay contrato revisado (docs/arranque.md, Fase 2)."
  fi
fi
# --- Entrar a F5 es el cierre: estado.md no pasa a F5 sin `Ref: F5` -------------------------------
fase_prev=$(git show "$BASE:docs/estado.md" 2>/dev/null | grep -oE 'Fase actual:\*?\*?[[:space:]]*F[1-5]' | grep -oE 'F[1-5]' | head -1)
fase_cand=$(idx docs/estado.md | grep -oE 'Fase actual:\*?\*?[[:space:]]*F[1-5]' | grep -oE 'F[1-5]' | head -1)
if [ "$fase_cand" = "F5" ] && [ "$fase_prev" != "F5" ] && [ "$con_f5" -eq 0 ]; then
  fail "docs/estado.md pasa a F5 (antes: ${fase_prev:-sin fase}) sin 'Ref: F5': entrar a la Fase 5 es el cierre del ciclo y exige su trailer (conjunto PASA vigente y check_docs en modo cierre)$( [ "$MERGE_LIMPIO" -eq 1 ] && printf '; un merge que integra el cierre de una rama exige el recibo del conjunto sobre la huella del árbol integrado, no la de la rama')."
fi
# --- Transiciones de trazabilidad: nada desaparece; resuelto|verificado con referencia que resuelve --
if [ "$HAY_HISTORIAL" -eq 1 ]; then
  T_ANTES=$(git show "$BASE:docs/trazabilidad.md" 2>/dev/null | sh "$MET/scripts/trazabilidad.sh" -)
  T_AHORA=$(idx docs/trazabilidad.md | sh "$MET/scripts/trazabilidad.sh" -)
  ids_ahora=$(printf '%s\n' "$T_AHORA" | awk '$1 ~ /^(E|R|H)$/ {print $2}' | sort -u)
  for id in $(printf '%s\n' "$T_ANTES" | awk '$1 ~ /^(E|R|H)$/ {print $2}' | sort -u); do
    printf '%s\n' "$ids_ahora" | grep -qx "$id" || fail "el hallazgo $id tenía fila o entrada del Histórico en docs/trazabilidad.md (HEAD) y aquí desaparece: un hallazgo no se borra; se resuelve, se verifica y se compacta al Histórico."
  done
  pares_antes=$(printf '%s\n' "$T_ANTES" | awk '$1 ~ /^(E|R)$/ {print $2 ":" $4} $1=="H" {print $2 ":H"}')
  for par in $(printf '%s\n' "$T_AHORA" | awk '$1 ~ /^(E|R)$/ && $4 ~ /^(resuelto|verificado)$/ {print $2 ":" $4} $1=="H" {print $2 ":H"}'); do
    printf '%s\n' "$pares_antes" | grep -qx "$par" && continue   # ya estaba así en HEAD: no es transición
    id=${par%%:*}
    celda=$(printf '%s\n' "$T_AHORA" | awk -v id="$id" '$1=="RES" && $2==id {print substr($0, index($0,$3)); exit}')
    referencia_resuelve "$celda" || fail "$id pasa a '${par#*:}' sin una referencia que resuelva en la columna Resuelto ('$(printf '%s' "$celda" | cut -c1-50)'): escribe la ruta de la prueba o mutación (archivo:línea, existente en el índice) o el commit del historial que lo sostiene. Que la referencia demuestre la resolución lo juzga el revisor."
  done
fi

# --- Criterios históricos: lo que el último contrato revisado definía se conserva ----------------
# Todo `C<n>` del contrato revisado vigente sigue definido en docs/encuadre.md en cualquier commit
# (también un `Ref: F1`, una reentrada `Ref: F2` o un merge). Renumerar cuenta como desaparecer. Su fila
# de Cobertura la exige ya check_docs (un criterio sin fila o una fila huérfana); lo que solo se ve aquí
# es el borrado coherente de los dos.
# El contrato vigente se busca por la ESTRUCTURA de la historia, nunca por fechas: desde el padre, por
# primer padre, hasta el `Ref: F2` más cercano (en un adoptado, posterior a la Base del método). Un merge
# que no es `Ref: F2` cuenta en tres vías: lo que define el contrato vigente de cualquiera de sus padres,
# salvo lo que alguno de ellos ya había quitado respecto del de su base común. Así no se pierde un criterio
# del contrato que se integra, una rama vieja no pasa a mandar por ser más reciente, y un requisito
# retirado antes de esta regla no se vuelve a exigir (quitarlo después lo rechaza esta guarda en la rama
# donde ocurra). La historia previa no se reescribe. El texto del criterio sí se ajusta por reentrada. No
# decide sobre requisitos obsoletos: su retirada legítima no tiene todavía política propia
# (docs/arranque.md §Reentrada), y hasta entonces se conservan con su estado real.
EXIGIDOS_PY='
import re, subprocess, sys
# Ausencia legítima (no hay contrato anterior: ningún Ref: F2 en el recorrido, raíz, sin base común, antes
# de la Base del método) ≠ imposibilidad de calcular (un error de git, un contrato que debe existir y no se
# lee). Lo segundo termina con 2 y un diagnóstico; nunca se convierte en «sin criterios exigidos».
class NoCalculable(Exception): pass
bm = sys.argv[1]; inicio = sys.argv[2:]
F2 = re.compile(r"^Ref:[ \t]*F2[ \t]*$", re.M)
def git(*a, validos=(0,)):
    r = subprocess.run(["git", *a], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r.returncode not in validos:
        raise NoCalculable("git %s salió con %d: %s" % (" ".join(a), r.returncode, r.stderr.decode("utf-8", "replace").strip()))
    return r.returncode, r.stdout.decode("utf-8", "replace")
def previo_a_base(c):
    return bool(bm) and git("merge-base", "--is-ancestor", c, bm, validos=(0, 1))[0] == 0
def ids(c):  # un Ref: F2 es un contrato revisado: su encuadre tiene que poder leerse
    return {m.group(1): c for m in re.finditer(r"^- (C[0-9]+):", git("show", c + ":docs/encuadre.md")[1], re.M)}
memo = {}
def vigente(c):  # el contrato vigente en c: el Ref: F2 más cercano por primer padre; un merge, en tres vías
    if c in memo: return memo[c]
    x = c
    while True:
        if previo_a_base(x): r = {}; break
        if F2.search(git("log", "-1", "--format=%B", x)[1]): r = ids(x); break
        ps = git("rev-list", "--parents", "-n", "1", x)[1].split()[1:]
        if not ps: r = {}; break
        if len(ps) >= 2: r = tres_vias(ps); break
        x = ps[0]
    memo[c] = r; return r
def tres_vias(ps):
    a = vigente(ps[0]); r = dict(a); quitados = set()
    for p in ps[1:]:
        b = vigente(p); rc, mb = git("merge-base", ps[0], p, validos=(0, 1))
        m = vigente(mb.strip()) if rc == 0 and mb.strip() else {}
        quitados |= {k for k in m if k not in a or k not in b}
        for k, v in b.items(): r.setdefault(k, v)
    return {k: v for k, v in r.items() if k not in quitados}
try:
    r = tres_vias(inicio) if len(inicio) >= 2 else (vigente(inicio[0]) if inicio else {})
except NoCalculable as e:
    sys.stderr.write("%s\n" % e); sys.exit(2)
for k in sorted(r): print(k, r[k])
'
if [ "$HAY_HISTORIAL" -eq 1 ]; then
  # Las listas de este bloque son por líneas («C<n> <sha>»). Al salir se deja IFS como estaba, también
  # si estaba sin definir (un IFS vacío desactivaría la separación de palabras en el resto del hook).
  if [ -n "${IFS+x}" ]; then IFS_PREVIO=$IFS; IFS_DEFINIDO=1; else IFS_DEFINIDO=0; fi
  IFS='
'
  bm=$(base_metodo); bm=$([ -n "$bm" ] && git rev-parse --verify -q "$bm^{commit}" 2>/dev/null)
  lista_padres=$(printf '%s\n' "$padres" | tr ' ' '\n' | grep .)
  if [ "$(printf '%s\n' "$lista_padres" | grep -c .)" -ge 2 ]; then
    donde="un contrato revisado que este merge integra"
    # shellcheck disable=SC2086
    exigidos=$(python3 -I -c "$EXIGIDOS_PY" "$bm" $lista_padres 2>&1); rc_exig=$?
  else
    donde="el último contrato revisado"
    exigidos=$(python3 -I -c "$EXIGIDOS_PY" "$bm" "$BASE" 2>&1); rc_exig=$?
  fi
  # El cálculo solo vale si terminó bien y cada línea es «C<n> <sha>»: un error, una excepción o una
  # salida incompleta rechazan el commit; nunca equivalen a «sin criterios exigidos».
  if [ "$rc_exig" -ne 0 ] || printf '%s\n' "$exigidos" | grep . | grep -qvE '^C[0-9]+ [0-9a-f]{40}([0-9a-f]{24})?$'; then
    fail "no pude calcular los criterios que exige el contrato revisado (salida $rc_exig): $(printf '%s' "$exigidos" | tr '\n' ' ' | cut -c1-240). Sin ese cálculo no se puede comprobar que ningún criterio desaparece; revisa el repositorio (objetos de git, docs/encuadre.md de los Ref: F2)."
    exigidos=""
  fi
  ids_enc=$(idx docs/encuadre.md | grep -oE '^- C[0-9]+:' | grep -oE 'C[0-9]+' | sort -u)
  for l in $(printf '%s\n' "$exigidos" | grep .); do
    c=${l%% *}; src=${l#* }
    printf '%s\n' "$ids_enc" | grep -qx "$c" || fail "$c estaba en $donde (commit $(git rev-parse --short "$src"), 'Ref: F2') y desaparece de docs/encuadre.md: un criterio no se borra ni se renumera para cerrar. Su texto se ajusta por reentrada; la retirada de un requisito obsoleto aún no tiene política propia (docs/arranque.md §Reentrada) y, mientras tanto, se conserva con su estado real."
  done
  if [ "$IFS_DEFINIDO" -eq 1 ]; then IFS=$IFS_PREVIO; else unset IFS; fi
fi

# --- Cuerpo de scripts/check.sh (con «# contrato-check: 1») ---------------------------------------
# check.sh es el bloque canónico de la suite vigilada (hasta «# --- fin suite vigilada ---», que check_docs compara
# con docs/convenciones.md) y el CUERPO del proyecto: qué pruebas, lint y comparador corren. Antes del primer
# `Ref: F2` (diseño inicial, primera adopción) no hay contrato revisado y entra como el resto del rastro. Desde
# entonces, el cuerpo es producto: si no es idéntico al de algún padre, exige `Ref: I<n>`. Solo cambiar el bloque
# deja el cuerpo idéntico. La ausencia en el padre no exime (borrar y recrear, o un primer cuerpo tardío, son
# cambios del cuerpo). Se leen los blobs versionados (índice o REV, y los padres); un error de lectura RECHAZA el
# commit: nunca equivale a un cuerpo vacío. Un archivo sin el cierre del bloque o que no es regular no tiene cuerpo
# separable y cuenta como cambio.
cuerpo_de() {  # cuerpo_de <commit|INDICE> → huella del cuerpo, «ausente», «inseparable»; rc 2 si no se pudo leer
  if [ "$1" = INDICE ]; then e=$(git ls-files -s -- scripts/check.sh) || return 2
  else e=$(git ls-tree "$1" -- scripts/check.sh) || return 2; fi
  [ -n "$e" ] || { echo ausente; return 0; }
  modo=${e%% *}; id=$(printf '%s' "$e" | awk '{ if ($2 == "blob") print $3; else print $2 }')
  case "$modo" in 100644|100755) ;; *) echo inseparable; return 0 ;; esac
  git cat-file blob "$id" > "$CUERPO_TMP" 2>/dev/null || return 2
  grep -qx '# --- fin suite vigilada ---' "$CUERPO_TMP" || { echo inseparable; return 0; }
  sed -n '/^# --- fin suite vigilada ---$/,$p' "$CUERPO_TMP" | sed '1d' | git hash-object --stdin
}
if [ "$CONTRATO_CHECK" -eq 1 ] && [ "$MERGE_LIMPIO" -eq 0 ] && printf '%s\n' "$cambios" | grep -qx 'scripts/check.sh'; then
  # Se busca en TODOS los padres: un error en uno no queda oculto porque otro haya encontrado (o no) un F2.
  hay_contrato=0; err_f2=""
  for p in $padres_o_base; do
    busca_f2 "$p"
    case $? in 0) hay_contrato=1 ;; 1) ;; *) err_f2="${err_f2:+$err_f2; }en $(git rev-parse --short "$p" 2>/dev/null || printf '%s' "$p"), $F2_ERR" ;; esac
  done
  if [ -n "$err_f2" ]; then
    fail "no pude determinar si hay un 'Ref: F2' anterior ($err_f2): sin saberlo no se puede decidir si el cuerpo de scripts/check.sh exige revisión, y un error no equivale a «aún no hay contrato»."
  elif [ "$hay_contrato" -eq 1 ]; then
    CUERPO_TMP=$(mktemp 2>/dev/null || mktemp -t cuerpo)
    if [ -n "${REV:-}" ]; then hc=$(cuerpo_de "$REV"); else hc=$(cuerpo_de INDICE); fi; rc_c=$?
    igual=0; err_p=""
    for p in $padres_o_base; do
      hp=$(cuerpo_de "$p") || { err_p="$p"; break; }
      [ "$hc" != ausente ] && [ "$hc" != inseparable ] && [ "$hc" = "$hp" ] && igual=1
    done
    rm -f "$CUERPO_TMP"
    if [ "$rc_c" -ne 0 ] || [ -n "$err_p" ]; then
      fail "no pude leer scripts/check.sh ($( [ -n "$err_p" ] && printf 'en %s' "$(git rev-parse --short "$err_p" 2>/dev/null)" || printf 'en el candidato')): sin su contenido no se puede saber si el cuerpo cambió, y un error no equivale a un cuerpo vacío."
    elif [ "$igual" -eq 0 ]; then
      codigo=$(printf '%s\n%s\n' "$codigo" "scripts/check.sh (cuerpo)" | grep .)
    fi
  fi
fi

# Código sin revisión: cambios fuera del rastro/plantilla exigen `Ref: I<n>` (y, con él, el
# recibo del juez sobre esta huella). Un `Cierra:` solo o un `Ref: F#` no bastan.
if [ -n "$codigo" ] && [ "$con_incremento" -eq 0 ] && [ "$MERGE_LIMPIO" -eq 0 ]; then
  fail "el commit cambia código fuera del rastro ($(printf '%s\n' "$codigo" | head -3 | tr '\n' ' ')…) sin 'Ref: I<n>': el código entra solo como incremento con recibo del juez. Un 'Cierra:' o un 'Ref: F#' no acreditan revisión del código."
fi

# --- Cierre acotado de un ciclo posterior (Ref: F4 | F5) -----------------------------------------
# Con cubre= y excluye= en el recibo del conjunto, el cierre es del CICLO, no del producto: check_docs
# cierre exige verificado solo lo de cubre= y que lo de excluye= no figure como verificado. Sin esos
# campos rige el cierre global. excluye= admite solo pendientes históricos (docs/arranque.md §Reentrada):
#   P5  el último `Ref: F5` por PRIMER PADRE desde el padre (el cierre anterior de la línea integrada);
#   R   la apertura del ciclo: entre los `Ref: F2` que descienden de P5, el MÍNIMO por ascendencia (una
#       reentrada posterior desciende de él y no lo mueve); varios mínimos = aperturas independientes:
#       se detiene con diagnóstico y no elige (el cierre global sigue disponible);
#   a) el criterio estaba en el encuadre de P5; b) en R no estaba verificado; c) su línea es idéntica a
#   la de P5; d) hoy no está verificado. Un cambio de su garantía por otra vía (set de oro, archivos del
#   contrato) solo se avisa: lo juzgan el revisor funcional y el juez de conjunto.
# Nada de esto toca los fallos previos (M01): su comprobación de cierre sigue bloqueando F4/F5.
# Un error al calcular P5/R o al leer un contrato rechaza con diagnóstico; nunca equivale a «no hay».
CICLO_PY='
import re, subprocess, sys
class NoCalculable(Exception): pass
bm, base = sys.argv[1], sys.argv[2]
def trailer(n): return re.compile(r"^Ref:[ \t]*%s[ \t]*$" % n, re.M)
F2, F4, F5 = trailer("F2"), trailer("F4"), trailer("F5")
def git(*a, validos=(0,)):
    r = subprocess.run(["git", *a], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r.returncode not in validos:
        raise NoCalculable("git %s salió con %d: %s" % (" ".join(a), r.returncode, r.stderr.decode("utf-8", "replace").strip()))
    return r.returncode, r.stdout.decode("utf-8", "replace")
def previo_a_base(c): return bool(bm) and git("merge-base", "--is-ancestor", c, bm, validos=(0, 1))[0] == 0
def mensaje(c): return git("log", "-1", "--format=%B", c)[1]
def ancestro(a, b): return git("merge-base", "--is-ancestor", a, b, validos=(0, 1))[0] == 0
try:
    p5 = p4 = None; x = base
    while x and not previo_a_base(x):
        m = mensaje(x)
        if F5.search(m): p5 = x; break
        if p4 is None and F4.search(m): p4 = x
        ps = git("rev-list", "--parents", "-n", "1", x)[1].split()[1:]
        x = ps[0] if ps else None
    r = []
    if p5:
        cands = [c for c in git("rev-list", "--ancestry-path", p5 + ".." + base)[1].split() if F2.search(mensaje(c)) and not previo_a_base(c)]
        r = [c for c in cands if not any(o != c and ancestro(o, c) for o in cands)]
except NoCalculable as e:
    sys.stderr.write("%s\n" % e); sys.exit(2)
print("P5", p5 or "-"); print("P4", p4 or "-")
print("R", r[0] if len(r) == 1 else ("-" if not r else "AMBIGUO"))
for c in sorted(r) if len(r) > 1 else []: print("APERTURA", c)
'
CIERRE_CUBRE=""; CIERRE_EXCLUYE=""
alcance_f4() { printf '%s %s' "$(campo "$1" cubre)" "$(campo "$1" excluye)"; }
if [ "$cierre" -eq 1 ]; then
  rec_c=$(ultimo_recibo juez-conjunto conjunto F4); cu=$(campo "$rec_c" cubre); ex=$(campo "$rec_c" excluye)
  ciclo=""; rc_ciclo=0
  if [ "$HAY_HISTORIAL" -eq 1 ]; then
    bm_c=$(base_metodo); bm_c=$([ -n "$bm_c" ] && git rev-parse --verify -q "$bm_c^{commit}" 2>/dev/null)
    ciclo=$(python3 -I -c "$CICLO_PY" "$bm_c" "$BASE" 2>&1); rc_ciclo=$?
    if [ "$rc_ciclo" -ne 0 ] || ! printf '%s\n' "$ciclo" | grep -qE '^P5 ([0-9a-f]{40}([0-9a-f]{24})?|-)$' \
       || ! printf '%s\n' "$ciclo" | grep -qE '^R ([0-9a-f]{40}([0-9a-f]{24})?|-|AMBIGUO)$'; then
      fail "no pude determinar el cierre anterior y la apertura del ciclo (salida $rc_ciclo): $(printf '%s' "$ciclo" | tr '\n' ' ' | cut -c1-240). Sin ese cálculo no se valida el alcance del cierre."
      ciclo=""
    fi
  fi
  P5=$(printf '%s\n' "$ciclo" | sed -n 's/^P5 //p'); P4=$(printf '%s\n' "$ciclo" | sed -n 's/^P4 //p'); RC=$(printf '%s\n' "$ciclo" | sed -n 's/^R //p')
  # F5 conserva el alcance del Ref: F4 de este ciclo (el recibo que este fijó), en un sentido y en otro.
  if [ "$con_f5" -eq 1 ] && [ -n "$P4" ] && [ "$P4" != "-" ]; then
    log_p4=$(git show "$P4:docs/revisiones.log" 2>/dev/null) || fail "no pude leer docs/revisiones.log del Ref: F4 $(git rev-parse --short "$P4") para comparar el alcance del cierre."
    lp4=$(mktemp 2>/dev/null || mktemp -t f4); printf '%s\n' "$log_p4" > "$lp4"
    prev_p4=""; git show "$P4:scripts/recibos.sh" 2>/dev/null | grep -q 'contrato-recibos: 2' || prev_p4=previo
    rec_p4=$(sh "$MET/scripts/recibos.sh" ultimo juez-conjunto conjunto F4 "$lp4" $prev_p4 2>/dev/null); rm -f "$lp4"
    [ "$(alcance_f4 "$rec_p4")" = "$(alcance_f4 "$rec_c")" ] || fail "el Ref: F5 usa un recibo del conjunto con alcance '$(alcance_f4 "$rec_c")' y el Ref: F4 de este ciclo ($(git rev-parse --short "$P4")) fijó '$(alcance_f4 "$rec_p4")': el cierre conserva el alcance de su F4."
  elif [ "$con_f5" -eq 1 ] && [ -n "$cu$ex" ]; then
    fail "un cierre acotado (cubre=/excluye= en el recibo del conjunto) exige el Ref: F4 de este ciclo que fija ese alcance; no hay ninguno desde el cierre anterior."
  fi
  if [ -n "$cu$ex" ]; then
    ids_c=$(idx docs/encuadre.md | grep -oE '^- C[0-9]+:' | grep -oE 'C[0-9]+' | sort -u)
    printf '%s' "$cu" | grep -qxE 'C[0-9]+(,C[0-9]+)*' || fail "cubre='$cu' del recibo del conjunto no tiene la forma C<n>[,C<n>…]: un cierre acotado valida al menos un criterio."
    printf '%s' "$ex" | grep -qxE 'ninguno|C[0-9]+(,C[0-9]+)*' || fail "excluye='$ex' del recibo del conjunto no es 'ninguno' ni una lista C<n>[,C<n>…]."
    l_cu=$(printf '%s' "$cu" | tr ',' '\n' | grep -E '^C[0-9]+$'); l_ex=$(printf '%s' "$ex" | tr ',' '\n' | grep -E '^C[0-9]+$')
    for c in $l_cu $l_ex; do printf '%s\n' "$ids_c" | grep -qx "$c" || fail "$c aparece en cubre=/excluye= del recibo del conjunto y no está definido en docs/encuadre.md."; done
    for c in $l_cu; do printf '%s\n' "$l_ex" | grep -qx "$c" && fail "$c aparece a la vez en cubre= y excluye= del recibo del conjunto."; done
    for c in $ids_c; do printf '%s\n' "$l_cu" "$l_ex" | grep -qx "$c" || fail "$c no está ni en cubre= ni en excluye= del recibo del conjunto: cada criterio del encuadre se nombra en una de las dos."; done
    if [ -n "$l_ex" ]; then
      if [ -z "$ciclo" ]; then :   # ya rechazado arriba (sin historial o sin cálculo)
      elif [ "$P5" = "-" ]; then
        fail "excluye=$ex: no hay un ciclo cerrado anterior (ningún Ref: F5 en la línea integrada); el primer ciclo se cierra completo."
      elif [ "$RC" = "AMBIGUO" ]; then
        fail "excluye=$ex: el ciclo tiene aperturas independientes ($(printf '%s\n' "$ciclo" | sed -n 's/^APERTURA //p' | cut -c1-7 | tr '\n' ' ')): el cierre acotado no está disponible; el cierre global (recibo sin cubre=/excluye=) sigue disponible."
      elif [ "$RC" = "-" ]; then
        fail "excluye=$ex: no se abrió ningún ciclo después del cierre anterior ($(git rev-parse --short "$P5")): no hay pendientes históricos que excluir."
      else
        enc_p5=$(git show "$P5:docs/encuadre.md" 2>/dev/null) || fail "no pude leer docs/encuadre.md del cierre anterior ($(git rev-parse --short "$P5"))."
        traz_r=$(git show "$RC:docs/trazabilidad.md" 2>/dev/null | sh "$MET/scripts/trazabilidad.sh" -) || fail "no pude leer docs/trazabilidad.md de la apertura del ciclo ($(git rev-parse --short "$RC"))."
        for c in $l_ex; do
          lp5=$(printf '%s\n' "$enc_p5" | grep -E "^- $c:" | sed 's/[[:space:]]*$//')
          lnow=$(idx docs/encuadre.md | grep -E "^- $c:" | sed 's/[[:space:]]*$//')
          er=$(printf '%s\n' "$traz_r" | awk -v c="$c" '$1=="C" && $2==c {print $4; exit}')
          if [ -z "$lp5" ]; then
            fail "$c está en excluye= pero no estaba en el contrato del ciclo anterior cerrado ($(git rev-parse --short "$P5")): un criterio nuevo no es un pendiente histórico; se verifica o el cierre es global con él pendiente."
          elif [ -z "$er" ]; then
            fail "$c está en excluye= y no pude leer su estado en la apertura del ciclo ($(git rev-parse --short "$RC")): sin ese dato no se admite como pendiente histórico."
          elif [ "$er" = "verificado" ]; then
            fail "$c está en excluye= pero estaba verificado al abrir el ciclo ($(git rev-parse --short "$RC")): si se rompió durante el ciclo, se corrige; una reentrada posterior no lo convierte en pendiente histórico."
          elif [ "$lp5" != "$lnow" ]; then
            fail "$c está en excluye= pero su criterio cambió en este ciclo respecto del cierre anterior: con otra garantía no es un pendiente histórico."
          elif [ "$(estado_fila "$c")" = "verificado" ]; then
            fail "$c está en excluye= y figura como verificado: va en cubre=."
          fi
        done
        # c') Cambios de garantía por otra vía: solo aviso (lo juzgan el revisor funcional y el juez de conjunto).
        if o_p5=$(contrato "$P5" 2>/dev/null) && o_now=$(contrato "${REV:-INDICE}" 2>/dev/null); then
          d=$( { printf '%s\n' "$o_p5"; printf '%s\n' "$o_now"; } | grep -E '^(ORO|REF)' | sort | uniq -u | head -2 | cut -c1-80 | tr '\n' '|')
          [ -n "$d" ] && echo "⚠ commit-msg: el set de oro o los archivos del contrato cambiaron desde el cierre anterior ($d): comprueba que no altera la garantía de los excluidos ($ex); no lo decide el hook." >&2
        fi
      fi
    fi
    CIERRE_CUBRE=$cu; CIERRE_EXCLUYE=$ex
  fi
fi

if [ "$cierre" -eq 1 ] && [ "$FAIL" -eq 0 ]; then
  tmp=$(mktemp -d 2>/dev/null || mktemp -d -t commitmsg)
  trap 'rm -rf "$tmp" "$LOGTMP"' EXIT INT TERM
  prev=$(git show "$BASE:docs/estado.md" 2>/dev/null | grep -oE 'Fase actual:\*?\*?[[:space:]]*F[1-5]' | grep -oE 'F[1-5]' | head -1)
  # En el replay, el árbol del commit se materializa desde sus blobs (validar_historial.sh --materializa:
  # sin atributos que oculten o transformen); check_docs es el del commit o, anclado, el de METODO_DIR.
  if [ -n "${REV:-}" ]; then sh "$MET/scripts/pruebas/validar_historial.sh" --materializa "$REV" "$tmp"; else git checkout-index -a --prefix="$tmp/"; fi \
    && ( cd "$tmp" && env -u GIT_DIR FASE_PREVIA="$prev" CIERRE_CUBRE="$CIERRE_CUBRE" CIERRE_EXCLUYE="$CIERRE_EXCLUYE" sh "${METODO_DIR:+$METODO_DIR/}scripts/check_docs.sh" cierre ) \
    || fail "el trailer declara cierre de fase (Ref: F4|F5) pero check_docs.sh cierre no da PASA sobre lo que se commitea."
fi
[ "$FAIL" -eq 1 ] && exit 1
exit 0
