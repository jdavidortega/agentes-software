#!/bin/sh
# Hook de la plantilla. Guardas DURAS e independientes del lenguaje antes de cada commit.

# En el PRIMER commit del proyecto HEAD aún no existe: se compara contra el árbol
# vacío (patrón canónico) para que las guardas apliquen también ahí.
against=$(git rev-parse --verify HEAD 2>/dev/null || git hash-object -t tree /dev/null)

# 1) Nunca versionar secretos (defensa en profundidad, aunque el proyecto no use .env):
#    .env y variantes quedan fuera; .env.example SÍ se versiona (es la plantilla sin
#    valores reales, ver docs/convenciones.md §Variables de entorno y secretos).
if git diff --cached --name-only "$against" | grep -E '(^|/)\.env($|\.)' | grep -vE '(^|/)\.env\.example$' | grep -q .; then
  echo "✗ pre-commit: intentas commitear un .env. Va en .gitignore, nunca al repo." >&2
  exit 1
fi
#    Llaves privadas (PEM/OpenSSH/PKCS8) detectadas por CONTENIDO añadido, venga en el
#    archivo que venga. El patrón se construye partido (K''EY) y se excluye .githooks/
#    para que este propio hook no se detecte a sí mismo al commitearse.
key_re='BEGIN .*PRIVATE K''EY'
if git diff --cached "$against" -- . ':(exclude).githooks' | grep -Eq "^\+.*$key_re"; then
  echo "✗ pre-commit: lo staged añade una llave privada (PEM/OpenSSH/PKCS8). Nunca al repo." >&2
  exit 1
fi

# 2) Lint + formato + tests del stack. El DISEÑO debe definirlos y dejarlos en
#    scripts/check.sh (ver docs/convenciones.md §Comandos clave; debe tolerar la suite
#    de tests aún vacía). Si existe, debe pasar.
if [ -x scripts/check.sh ]; then
  scripts/check.sh || { echo "✗ pre-commit: scripts/check.sh falló (lint/formato/tests)." >&2; exit 1; }
else
  echo "• pre-commit: no hay scripts/check.sh. Define lint+formato+tests del stack y" >&2
  echo "  cabléalos ahí (salida obligatoria del diseño; ver docs/convenciones.md)." >&2
fi

# 3) Integridad del rastro documental (viene con la plantilla; modo commit).
#    Al cierre de F4/F5 se corre además: scripts/check_docs.sh cierre (ver AGENTS.md §8).
if [ -x scripts/check_docs.sh ]; then
  scripts/check_docs.sh commit || { echo "✗ pre-commit: scripts/check_docs.sh falló (rastro documental)." >&2; exit 1; }
fi
exit 0
