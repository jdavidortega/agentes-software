#!/bin/sh
# Hook de la plantilla. Guardas DURAS e independientes del lenguaje antes de cada commit.
# Principio: lo que se verifica es lo que se versiona (el ÍNDICE), no el árbol de trabajo.

# En el PRIMER commit del proyecto HEAD aún no existe: se compara contra el árbol
# vacío (patrón canónico) para que las guardas apliquen también ahí.
against=$(git rev-parse --verify HEAD 2>/dev/null || git hash-object -t tree /dev/null)

# 1) Guardas de CONTENIDO (secretos, registros y suite que no desaparecen, append-only de
#    los recibos): una sola implementación, scripts/guardas.sh, la misma que usa el replay en
#    CI (scripts/pruebas/validar_historial.sh). Base = HEAD (o el árbol vacío), candidato = el índice.
git ls-files --error-unmatch scripts/guardas.sh >/dev/null 2>&1 \
  || { echo "✗ pre-commit: scripts/guardas.sh no está versionado. Viene con la plantilla; sin él no hay guardas de contenido." >&2; exit 1; }
sh scripts/guardas.sh "$against" INDICE || { echo "✗ pre-commit: guardas de contenido (arriba)." >&2; exit 1; }

# 1b) Flags del índice que hacen MENTIR a todo lo demás: con assume-unchanged (h) o
#     skip-worktree (S) git da por idéntico un archivo que cambió, `git diff --quiet`
#     devuelve 0 y la huella se calcula sobre el contenido viejo. Incompatibles con el método.
flags=$(git ls-files -v | grep -E '^[a-z]|^S' || true)
if [ -n "$flags" ]; then
  echo "✗ pre-commit: archivos con assume-unchanged/skip-worktree (ocultan cambios a las guardas):" >&2
  printf '%s\n' "$flags" | sed 's/^/    /' >&2
  echo "  Quita el flag (git update-index --no-assume-unchanged / --no-skip-worktree <archivo>) y repite." >&2
  exit 1
fi

# 2) Lo verificado debe ser lo versionado. Un `git add -p` parcial deja el árbol de
#    trabajo distinto del índice: la suite pasaría sobre código que no se commitea.
#    Regla: ningún archivo rastreado con cambios sin stagear en el momento del commit.
if ! git diff --quiet; then
  echo "✗ pre-commit: hay archivos rastreados con cambios sin stagear:" >&2
  git diff --name-only | sed 's/^/    /' >&2
  echo "  Lo que se prueba tiene que ser lo que se versiona: stagea todo (git add -u) o guarda aparte (git stash -k)." >&2
  exit 1
fi

# 3) Integridad del rastro documental, sobre una EXPORTACIÓN DEL ÍNDICE (exactamente lo
#    que va al commit). El script se invoca con intérprete explícito: su bit de ejecución
#    no decide si el control corre, y su ausencia es un fallo, no un aviso.
if ! git ls-files --error-unmatch scripts/check_docs.sh >/dev/null 2>&1; then
  echo "✗ pre-commit: scripts/check_docs.sh no está versionado. Viene con la plantilla; sin él no hay control del rastro." >&2
  exit 1
fi
tmp=$(mktemp -d 2>/dev/null || mktemp -d -t precommit)
trap 'rm -rf "$tmp"' EXIT INT TERM
git checkout-index -a --prefix="$tmp/" || { echo "✗ pre-commit: no pude exportar el índice." >&2; exit 1; }
#    La fase que HEAD ya declaraba viaja con la exportación (sin .git no se puede leer):
#    un proyecto iniciado no vuelve a "modo plantilla" por perder o estropear la línea.
fase_prev=$(git show HEAD:docs/estado.md 2>/dev/null | grep -oE 'Fase actual:\*?\*?[[:space:]]*F[1-5]' | grep -oE 'F[1-5]' | head -1)
( cd "$tmp" && FASE_PREVIA="$fase_prev" sh scripts/check_docs.sh commit ) \
  || { echo "✗ pre-commit: scripts/check_docs.sh falló sobre el índice (rastro documental)." >&2; exit 1; }

# 4) Lint + formato + tests del stack (scripts/check.sh, salida obligatoria del diseño;
#    debe tolerar la suite de tests aún vacía). Corre sobre el árbol de trabajo, que por
#    (2) coincide con el índice en todo archivo rastreado. Con el proyecto INICIADO
#    (docs/estado.md en F2..F5, o HEAD ya lo estaba) su ausencia bloquea; antes, avisa.
fase=$(grep -oE 'Fase actual:\*?\*?[[:space:]]*F[1-5]' "$tmp/docs/estado.md" 2>/dev/null | grep -oE 'F[1-5]' | head -1)
case "$fase_prev" in F2|F3|F4|F5) fase="$fase_prev" ;; esac
if [ -f scripts/check.sh ]; then
  sh scripts/check.sh || { echo "✗ pre-commit: scripts/check.sh falló (lint/formato/tests)." >&2; exit 1; }
  # 5) Lo probado tiene que ser lo guardado TAMBIÉN después de la suite: un formatter
  #    con auto-fix o un test que escribe un fixture dejarían en el árbol algo distinto
  #    de lo que va al commit. Se compara otra vez y, si cambió, se rechaza.
  if ! git diff --quiet; then
    echo "✗ pre-commit: scripts/check.sh modificó archivos rastreados después de la comparación:" >&2
    git diff --name-only | sed 's/^/    /' >&2
    echo "  Lo que se commitea no es lo que se probó. Stagea los cambios (git add -u) y repite el commit." >&2
    exit 1
  fi
else
  case "$fase" in
    F2|F3|F4|F5)
      echo "✗ pre-commit: no hay scripts/check.sh y el proyecto está en $fase. Es salida obligatoria del diseño (docs/convenciones.md §Comandos clave)." >&2
      exit 1 ;;
    *)
      echo "• pre-commit: aún no hay scripts/check.sh (llega con el diseño, F2); hasta entonces solo aviso." >&2 ;;
  esac
fi
exit 0
